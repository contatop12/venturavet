{
  "name": "venturavet-site",
  "version": "1.0.0",
  "private": true,
  "description": "Site estático da Ventura Veterinária & Pet Shop — HTML, CSS e TypeScript.",
  "type": "module",
  "scripts": {
    "dev": "tsx build/dev.ts",
    "build": "tsx build/build.ts",
    "preview": "tsx build/dev.ts --preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p worker",
    "import:wp": "tsx tools/import-wp.ts",
    "media:video": "tsx tools/optimize-video.ts",
    "check": "tsx build/check.ts",
    "cf:dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "deploy:check": "wrangler deploy --dry-run && npm run check",
    "cf:types": "wrangler types worker/worker-configuration.d.ts"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@fontsource-variable/red-hat-display": "^5.3.0",
    "@fontsource-variable/red-hat-text": "^5.3.0",
    "@types/html-minifier-terser": "^7.0.2",
    "@types/node": "^26.6.6",
    "cheerio": "^1.2.0",
    "esbuild": "^0.28.2",
    "html-minifier-terser": "^7.2.0",
    "lightningcss": "^1.33.0",
    "lucide-static": "^1.69.0",
    "sharp": "^0.35.5",
    "simple-icons": "^16.36.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "wrangler": "^4.158.0"
  }
}
